{
  "name": "orbitworks-pass-explorer",
  "private": true,
  "description": "Map-centric explorer for simulated satellite passes (Orbitworks FS coding challenge)",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare": "node scripts/prepare.mjs",
    "dev": "pnpm --parallel --filter @ow/api --filter @ow/web dev",
    "build": "pnpm -r build",
    "seed": "pnpm --filter @ow/api seed",
    "test": "pnpm -r test && pnpm test:harness",
    "test:coverage": "pnpm -r test:coverage && pnpm test:harness",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm lint:js && pnpm lint:css",
    "lint:js": "eslint . --max-warnings=0 --cache --cache-location node_modules/.cache/eslint/",
    "lint:css": "stylelint \"**/*.css\" --allow-empty-input",
    "lint:fix": "eslint . --fix && stylelint \"**/*.css\" --fix --allow-empty-input",
    "lint:secrets": "secretlint \"**/*\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "pnpm -r --if-present size",
    "e2e": "pnpm -r --if-present e2e",
    "verify": "node scripts/verify.mjs",
    "verify:fast": "node scripts/verify.mjs --fast",
    "test:harness": "vitest run --config vitest.config.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.1",
    "globals": "^17.12.0",
    "lefthook": "^2.1.14",
    "prettier": "^3.9.9",
    "secretlint": "^13.0.5",
    "stylelint": "^17.15.0",
    "stylelint-config-css-modules": "^4.6.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
