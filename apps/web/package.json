{
  "name": "@ow/web",
  "version": "1.0.0",
  "private": true,
  "description": "Map-centric satellite pass explorer (React + MapLibre + deck.gl)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:changed": "vitest run --changed --passWithNoTests",
    "size": "node scripts/size-check.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "e2e": "vite build --mode e2e --outDir dist-e2e && playwright test",
    "smoke": "playwright test -c playwright.smoke.config.ts"
  },
  "dependencies": {
    "@deck.gl/core": "~9.4.0",
    "@deck.gl/layers": "~9.4.0",
    "@deck.gl/mapbox": "~9.4.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@luma.gl/core": "~9.4.2",
    "@luma.gl/engine": "~9.4.2",
    "@luma.gl/shadertools": "~9.4.2",
    "@math.gl/web-mercator": "^4.1.0",
    "@ow/shared": "workspace:*",
    "@tanstack/react-query": "^5.105.0",
    "maplibre-gl": "^6.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "chrome-launcher": "^1.2.2",
    "jsdom": "^30.1.3",
    "lighthouse": "^13.5.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
