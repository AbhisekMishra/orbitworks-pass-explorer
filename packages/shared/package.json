{
  "name": "@ow/shared",
  "version": "1.0.0",
  "private": true,
  "description": "API contract (zod schemas + types), spherical geometry and the binary track codec shared by the API and the web app",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@ow/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:changed": "vitest run --changed --passWithNoTests"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.1",
    "vitest": "^5.0.1",
    "fast-check": "^4.10.2"
  }
}
